# Disposable local development values only; do not reuse them in deployments.
# Copy to .env in the repository root. Git ignores .env files.
POSTGRES_DB=dwi
POSTGRES_USER=dwi
POSTGRES_PASSWORD=dwi_local_only
POSTGRES_PORT=5432

# Used by the TKT-003 ingestion CLI and Alembic; set in the backend process environment or use the local-only fallback.
DATABASE_URL=postgresql://dwi:dwi_local_only@127.0.0.1:5432/dwi

# The backend's default CORS list includes both local Vite origins.
DWI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Do NOT enable this until source permissions and retention have been reviewed.
# DWI_SOURCE_USE_APPROVED=1

# Development-only: opt in to the /api/v1/postings read endpoint.
# It still reads ONLY uniquely labeled synthetic smoke-test sources.
# Set this explicitly in the backend process and use dwi_ingestion_test;
# never enable this unauthenticated endpoint on a public service.
# DWI_POSTINGS_API_ENABLED=1
