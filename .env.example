# Disposable local development values only; do not reuse them in deployments.
# Copy to .env in the repository root. Git ignores .env files.
POSTGRES_DB=dwi
POSTGRES_USER=dwi
POSTGRES_PASSWORD=dwi_local_only
POSTGRES_PORT=5432

# Reference DSN for planned database integration (not used by TKT-001 API routes).
DATABASE_URL=postgresql://dwi:dwi_local_only@127.0.0.1:5432/dwi

# The backend's default CORS list includes both local Vite origins.
DWI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
